# MediaVault environment
API_TOKEN=generate-a-long-random-token
AUTH_PASSWORD_HASH=pbkdf2_sha256$600000$base64-salt$base64-derived-key
AUTH_SESSION_SECRET=generate-a-long-random-session-secret
VAULT_KEY=change-me-generate-via-keygen
DATABASE_URL=sqlite:///./data/mediavault.db
MEDIA_ROOT=./media
# Optional: Netscape-format cookies.txt export (gallery-dl & yt-dlp)
COOKIES_FILE=
# Optional: instaloader session file path (for IG private/saved)
INSTAGRAM_SESSION_FILE=
INSTAGRAM_USERNAME=
